{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.pdfloom/pdfloom",
  "title": "PDFLoom",
  "description": "HTML or URL to PDF with headless Chrome, and invoice/receipt/quote PDFs from JSON.",
  "websiteUrl": "https://pdfloom.dev/docs#mcp",
  "repository": {
    "url": "https://github.com/cloud18dev/pdfloom-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://pdfloom.dev/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://pdfloom.dev/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "version": "1.2.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://pdfloom.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional: API key from https://pdfloom.dev/dashboard ('Bearer plk_...'). Without it, clients sign in with OAuth.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
